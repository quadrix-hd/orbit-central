# Opt-in Go migration preview. Keep production on Dockerfile until parity checks pass.
FROM golang:1.27.3-trixie AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/orbit ./cmd/orbit

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home orbit && mkdir /data && chown orbit:orbit /data
WORKDIR /app
ENV ORBIT_DATA_DIR=/data PORT=8080 ORBIT_STATIC_DIR=/app/dist
COPY --from=build /out/orbit /usr/local/bin/orbit
COPY dist ./dist
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 CMD ["orbit","healthcheck"]
ENTRYPOINT ["orbit"]
