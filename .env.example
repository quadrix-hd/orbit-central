# Für den ersten Start lokal oder über SSH-Tunnel öffnen.
ORBIT_LISTEN=127.0.0.1
ORBIT_PORT=8080
ORBIT_PUBLIC_ORIGIN=http://localhost:8080
# HTTPS-Reverse-Proxy: ORBIT_PUBLIC_ORIGIN=https://orbit.example.lan
# Eigene Proxmox-CA: Volume in compose.yaml aktivieren.
ORBIT_CA_FILE=

# Zentrale, vom Herausgeber gepflegte Marketplace-Quelle (HTTPS-JSON).
ORBIT_CATALOG_URL=
