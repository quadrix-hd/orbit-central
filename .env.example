# Für den ersten Start lokal oder über SSH-Tunnel öffnen.
ORBIT_LISTEN=127.0.0.1
ORBIT_PORT=8080
ORBIT_PUBLIC_ORIGIN=http://localhost:8080
# HTTPS-Reverse-Proxy: ORBIT_PUBLIC_ORIGIN=https://orbit.example.lan
# Eigene Proxmox-CA: Volume in compose.yaml aktivieren.
ORBIT_CA_FILE=

# Reverse-Proxy (Traefik, nginx, Caddy): IP/CIDR des Proxys, damit
# Anmeldebegrenzung und Audit die echte Client-IP aus X-Forwarded-For nutzen.
# Leer lassen, wenn Orbit direkt erreichbar ist. Beispiel: 172.16.0.0/12
ORBIT_TRUSTED_PROXIES=

# Zentrale, vom Herausgeber gepflegte Marketplace-Quelle (HTTPS-JSON).
ORBIT_CATALOG_URL=https://quadrix-hd.github.io/orbit-central/catalog.json

# web = Download bei Bedarf; cache = alle Paketdateien lokal vorhalten.
ORBIT_CATALOG_MODE=web
